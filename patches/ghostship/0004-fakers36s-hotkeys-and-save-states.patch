+# FakeR36S: handheld hotkeys and save states (src/port/FrSaveStates.cpp). The game's variables in one range
+# (fakers36s-state.ld) and the executable's own allocations recorded while an asset is built (--wrap), so a state
+# written to the card can be read back after a restart (with -no-pie: the same addresses on every run).
+option(FAKER36S "FakeR36S-OS: hotkeys and save states" OFF)
+if(FAKER36S)
+    target_compile_definitions(${PROJECT_NAME} PRIVATE FAKER36S=1)
+    target_link_options(${PROJECT_NAME} PRIVATE "-Wl,-T,${CMAKE_CURRENT_SOURCE_DIR}/fakers36s-state.ld"
+        "-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=free")
+    set_property(TARGET ${PROJECT_NAME} APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/fakers36s-state.ld")
+endif()
 ################################################################################
 # Compile and link options
