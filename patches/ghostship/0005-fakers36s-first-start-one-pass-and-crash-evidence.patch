diff --git a/src/port/FrCrash.cpp b/src/port/FrCrash.cpp
new file mode 100644
index 0000000..2a6ab7a
--- /dev/null
+++ b/src/port/FrCrash.cpp
@@ -0,0 +1,173 @@
+// FakeR36S-SM64: evidence when the game ends. libultraship's own handlers exit(1) without a word on SIGTERM, SIGINT
+// and SIGQUIT, and its crash report needs a live context (it is gone once the game started shutting down, and then it
+// exits(1) without a word too). These replace them:
+//   SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT: the signal, the faulting address, the thread and a backtrace straight to
+//     stderr (HOME/logs/sm64.log, through the launcher) and to HOME/.config/sm64/logs/crash.log, then the default
+//     action, so the launcher sees 128 + the signal (139 SIGSEGV, 132 SIGILL...).
+//   SIGTERM, SIGINT, SIGQUIT, SIGHUP: logged with the sender's pid and command line. While the ROM is being extracted
+//     they wait until it is done (sm64.o2r is kept); otherwise the game quits the clean way (FrSaveStates).
+// Only async-signal-safe calls in the handlers (write, open, read, backtrace_symbols_fd after a first backtrace()).
+#ifdef FAKER36S
+
+#include <execinfo.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <string>
+
+#include <spdlog/spdlog.h>
+#include <ship/Context.h>
+
+static volatile sig_atomic_t sExtracting = 0;
+static volatile sig_atomic_t sQuitAsked = 0;
+static int sCrashFd = -1;
+static char sAltStack[64 * 1024];
+
+static void Out(const char* s) {
+    const size_t n = strlen(s);
+    if (write(2, s, n) < 0) {
+    }
+    if (sCrashFd >= 0 && write(sCrashFd, s, n) < 0) {
+    }
+}
+
+static void OutNum(const char* label, uintptr_t v, bool hex) {
+    char buf[64];
+    char digits[24];
+    int n = 0;
+    const unsigned base = hex ? 16 : 10;
+    do {
+        digits[n++] = "0123456789abcdef"[v % base];
+        v /= base;
+    } while (v != 0 && n < (int)sizeof(digits));
+    size_t p = 0;
+    for (const char* l = label; *l && p < sizeof(buf) - 30; l++) buf[p++] = *l;
+    if (hex) {
+        buf[p++] = '0';
+        buf[p++] = 'x';
+    }
+    while (n > 0) buf[p++] = digits[--n];
+    buf[p] = 0;
+    Out(buf);
+}
+
+static const char* Name(int sig) {
+    switch (sig) {
+        case SIGSEGV: return "SIGSEGV (invalid memory access)";
+        case SIGBUS: return "SIGBUS (bus error)";
+        case SIGILL: return "SIGILL (illegal instruction)";
+        case SIGFPE: return "SIGFPE (arithmetic error)";
+        case SIGABRT: return "SIGABRT (abort)";
+        case SIGTERM: return "SIGTERM";
+        case SIGINT: return "SIGINT";
+        case SIGQUIT: return "SIGQUIT";
+        case SIGHUP: return "SIGHUP";
+        default: return "signal";
+    }
+}
+
+static void Fatal(int sig, siginfo_t* info, void*) {
+    Out("\n[FakeR36S] CRASH: ");
+    Out(Name(sig));
+    OutNum(", signal ", (uintptr_t)sig, false);
+    OutNum(", address ", (uintptr_t)(info != nullptr ? info->si_addr : nullptr), true);
+    OutNum(", code ", (uintptr_t)(info != nullptr ? info->si_code : 0), false);
+    OutNum(", thread ", (uintptr_t)syscall(SYS_gettid), false);
+    OutNum(" of process ", (uintptr_t)getpid(), false);
+    Out(sExtracting ? ", while extracting the ROM\n" : "\n");
+    void* frames[64];
+    const int n = backtrace(frames, 64);
+    Out("[FakeR36S] backtrace (addresses in the Ghostship binary: arm-linux-gnueabihf-addr2line -e Ghostship):\n");
+    backtrace_symbols_fd(frames, n, 2);
+    if (sCrashFd >= 0) backtrace_symbols_fd(frames, n, sCrashFd);
+    Out("[FakeR36S] end of crash report\n");
+    if (sCrashFd >= 0) fsync(sCrashFd);
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static void Quit(int sig, siginfo_t* info, void*) {
+    const pid_t from = info != nullptr ? info->si_pid : 0;
+    Out("\n[FakeR36S] ");
+    Out(Name(sig));
+    OutNum(" received from pid ", (uintptr_t)from, false);
+    if (from > 0) {
+        char path[48] = "/proc/";
+        char num[16];
+        int n = 0;
+        pid_t v = from;
+        do {
+            num[n++] = '0' + v % 10;
+            v /= 10;
+        } while (v != 0);
+        size_t p = strlen(path);
+        while (n > 0) path[p++] = num[--n];
+        memcpy(path + p, "/cmdline", 9);
+        int fd = open(path, O_RDONLY);
+        if (fd >= 0) {
+            char cmd[200];
+            ssize_t r = read(fd, cmd, sizeof(cmd) - 1);
+            close(fd);
+            if (r > 0) {
+                for (ssize_t i = 0; i < r; i++) {
+                    if (cmd[i] == 0) cmd[i] = ' ';
+                }
+                cmd[r] = 0;
+                Out(" (");
+                Out(cmd);
+                Out(")");
+            }
+        }
+    }
+    if (sExtracting) {
+        Out(": the ROM is being extracted, the game quits once sm64.o2r is written\n");
+    } else {
+        Out(": quitting\n");
+    }
+    sQuitAsked = 1;
+}
+
+extern "C" void FrCrash_Install(void) {
+    // the first backtrace() loads libgcc_s, which is not safe from inside a signal handler
+    void* warm[2];
+    backtrace(warm, 2);
+    if (sCrashFd < 0) {
+        const std::string dir = Ship::Context::GetPathRelativeToAppDirectory("logs", "sm64");
+        sCrashFd = open((dir + "/crash.log").c_str(), O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+    }
+    stack_t ss = {};
+    ss.ss_sp = sAltStack;
+    ss.ss_size = sizeof(sAltStack);
+    sigaltstack(&ss, nullptr); // the main thread's own stack may be what overflowed
+
+    struct sigaction fatal = {};
+    fatal.sa_sigaction = Fatal;
+    fatal.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESETHAND;
+    sigemptyset(&fatal.sa_mask);
+    for (int s : { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT }) sigaction(s, &fatal, nullptr);
+
+    struct sigaction quit = {};
+    quit.sa_sigaction = Quit;
+    quit.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset(&quit.sa_mask);
+    for (int s : { SIGTERM, SIGINT, SIGQUIT, SIGHUP }) sigaction(s, &quit, nullptr);
+
+    spdlog::flush_on(spdlog::level::trace); // nothing waits in a buffer when the game ends
+}
+
+extern "C" void FrCrash_SetExtracting(int on) {
+    sExtracting = on ? 1 : 0;
+}
+
+extern "C" int FrCrash_QuitAsked(void) {
+    return sQuitAsked != 0;
+}
+
+#endif // FAKER36S
