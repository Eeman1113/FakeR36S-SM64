+// FakeR36S: .v64 (byte-swapped) and .n64 (little-endian) dumps of the same ROM become the .z64 (big-endian) the
+// checksums and Torch expect
+static void NormalizeByteOrder(std::vector<uint8_t>& data) {
+    if (data.size() < 4 || data.size() % 4 != 0) {
+        return;
+    }
+    if (data[0] == 0x37 && data[1] == 0x80 && data[2] == 0x40 && data[3] == 0x12) {
+        for (size_t i = 0; i + 1 < data.size(); i += 2) {
+            std::swap(data[i], data[i + 1]);
+        }
+        SPDLOG_INFO("ROM is byte-swapped (.v64): converted to .z64 order");
+    } else if (data[0] == 0x40 && data[1] == 0x12 && data[2] == 0x37 && data[3] == 0x80) {
+        for (size_t i = 0; i + 3 < data.size(); i += 4) {
+            std::swap(data[i], data[i + 3]);
+            std::swap(data[i + 1], data[i + 2]);
+        }
+        SPDLOG_INFO("ROM is little-endian (.n64): converted to .z64 order");
+    }
+}
